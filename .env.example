# Copy this file to ".env" (same folder) and fill in your own values.
# .env is git-ignored, so your key is never uploaded. Never put a real key in this file.
# Free key: https://aistudio.google.com -> Get API key -> Create API key

AI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
AI_MODEL=gemini-3.6-flash
AI_API_KEY=

# Optional, for gpt-oss (Groq) or Gemini models: think less = faster and fewer tokens.
# AI_REASONING_EFFORT=low
